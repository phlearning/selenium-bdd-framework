<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Project rules. Layout (indentation, line breaks, import order) is Spotless's job
  (palantir-java-format): these rules only cover what a formatter cannot fix.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>

    <!-- House rule: no em dash, use a plain hyphen -->
    <module name="RegexpSingleline">
        <property name="format" value="—"/>
        <property name="message" value="Tiret cadratin interdit : utiliser un tiret normal (-)"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Naming -->
        <module name="TypeName"/>
        <module name="MethodName">
            <!-- Step definitions are named after their French Gherkin phrase -->
            <property name="format" value="^[a-z][a-zA-Z0-9À-ÿ]*$"/>
        </module>
        <module name="MemberName"/>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9À-ÿ]*$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Robustness -->
        <module name="EmptyCatchBlock"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="OneStatementPerLine"/>
        <module name="NeedBraces"/>
        <module name="ModifiedControlVariable"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="FinalClass"/>

        <!-- Test automation rules -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="Thread\.sleep\("/>
            <property name="message" value="Pas de Thread.sleep : utiliser une attente explicite (BasePage, WebDriverWait, FluentWait)"/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="implicitlyWait\((?!Duration\.ZERO)"/>
            <property name="message" value="Attente implicite interdite : elle se mélange mal aux attentes explicites"/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print"/>
            <property name="message" value="Utiliser un logger SLF4J : les logs sont joints au rapport du scénario"/>
            <property name="ignoreComments" value="true"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\.printStackTrace\(\)"/>
            <property name="message" value="Journaliser l'exception avec SLF4J ou la relancer"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
