# Copy to .env (git-ignored) and fill in. Keys map to config keys:
# SAUCE_USERNAME <-> sauce.username
# The saucedemo.com demo credentials are displayed on its login page.
SAUCE_USERNAME=
SAUCE_PASSWORD=

# Any other config key can be overridden the same way, e.g.:
# BROWSER=firefox
# HEADLESS=true

# With -Dexecution=grid, browsers run in Docker and reach the-internet through the Docker network:
# THE_INTERNET_URL=http://the-internet:5000
